[TITLE]
;;Project Title/Notes
Tiny test network for SWMM Studio (2 subcatchments, RDII, external rainfall file)

[OPTIONS]
;;Option             Value
FLOW_UNITS           LPS
INFILTRATION         HORTON
FLOW_ROUTING         DYNWAVE
LINK_OFFSETS         DEPTH
MIN_SLOPE            0
ALLOW_PONDING        NO
SKIP_STEADY_STATE    NO

START_DATE           06/01/2024
START_TIME           00:00:00
REPORT_START_DATE    06/01/2024
REPORT_START_TIME    00:00:00
END_DATE             06/03/2024
END_TIME             00:00:00
SWEEP_START          01/01
SWEEP_END            12/31
DRY_DAYS             3
REPORT_STEP          00:05:00
WET_STEP             00:01:00
DRY_STEP             00:05:00
ROUTING_STEP         0:00:10

INERTIAL_DAMPING     PARTIAL
NORMAL_FLOW_LIMITED  BOTH
FORCE_MAIN_EQUATION  H-W
VARIABLE_STEP        0.75
LENGTHENING_STEP     0
MIN_SURFAREA         1.167
MAX_TRIALS           8
HEAD_TOLERANCE       0.0015
SYS_FLOW_TOL         5
LAT_FLOW_TOL         5
MINIMUM_STEP         0.5
THREADS              1

[EVAPORATION]
;;Data Source    Parameters
CONSTANT         0.0
DRY_ONLY         NO

[RAINGAGES]
;;Name           Format    Interval SCF      Source
RG1              INTENSITY 0:05     1.0      TIMESERIES Storm

[SUBCATCHMENTS]
;;Name           Rain Gage        Outlet           Area     %Imperv  Width    %Slope   CurbLen  SnowPack
S1               RG1              J1               2.5      60       150      1.5      0
S2               RG1              J2               4.0      35       200      2.0      0

[SUBAREAS]
;;Subcatchment   N-Imperv   N-Perv     S-Imperv   S-Perv     PctZero    RouteTo    PctRouted
S1               0.013      0.15       1.5        5          25         OUTLET
S2               0.013      0.15       1.5        5          25         OUTLET

[INFILTRATION]
;;Subcatchment   Param1     Param2     Param3     Param4     Param5
S1               75         5          4          7          0
S2               75         5          4          7          0

[JUNCTIONS]
;;Name           Elevation  MaxDepth   InitDepth  SurDepth   Aponded
J1               100.0      2.5        0          0          0
J2               99.2       2.5        0          0          0
J3               98.5       3.0        0          0          0

[OUTFALLS]
;;Name           Elevation  Type       Stage Data       Gated    Route To
Out1             97.8       FREE                        NO

[CONDUITS]
;;Name           From Node        To Node          Length     Roughness  InOffset   OutOffset  InitFlow   MaxFlow
C1               J1               J2               120        0.013      0          0          0          0
C2               J2               J3               150        0.013      0          0          0          0
C3               J3               Out1             90         0.013      0          0          0          0

[XSECTIONS]
;;Link           Shape        Geom1            Geom2      Geom3      Geom4      Barrels    Culvert
C1               CIRCULAR     0.4              0          0          0          1
C2               CIRCULAR     0.5              0          0          0          1
C3               CIRCULAR     0.6              0          0          0          1

[RDII]
;;Node           Unit Hydrograph  Sewer Area
J2               UH1              10

[HYDROGRAPHS]
;;Hydrograph     Rain Gage/Month  Response R        T        K        Dmax     Drecov   Dinit
UH1              RG1
UH1              All              Short    0.02     1        2
UH1              All              Medium   0.03     4        3
UH1              All              Long     0.02     12       4

[TIMESERIES]
;;Name           Date       Time       Value
Storm            FILE "storm.dat"

[REPORT]
;;Reporting Options
SUBCATCHMENTS ALL
NODES ALL
LINKS ALL

[MAP]
DIMENSIONS 0.000 0.000 10000.000 10000.000
Units      None

[COORDINATES]
;;Node           X-Coord            Y-Coord
J1               651200.000         6862100.000
J2               651300.000         6862050.000
J3               651420.000         6861980.000
Out1             651500.000         6861950.000

[POLYGONS]
;;Subcatchment   X-Coord            Y-Coord
S1               651150.000         6862200.000
S1               651250.000         6862200.000
S1               651250.000         6862120.000
S1               651150.000         6862120.000
S2               651280.000         6862150.000
S2               651400.000         6862150.000
S2               651400.000         6862070.000
S2               651280.000         6862070.000

[SYMBOLS]
;;Gage           X-Coord            Y-Coord
RG1              651100.000         6862250.000
